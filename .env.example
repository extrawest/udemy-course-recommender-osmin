# Google AI Studio (Gemini) API key — chat LLM, vision OCR and embeddings — https://aistudio.google.com/
GOOGLE_API_KEY=

# Pinecone vector DB creds — https://www.pinecone.io/
PINECONE_API_KEY=
PINECONE_INDEX_NAME=udemy-courses

# Postgres connection string for the LangGraph checkpointer.
# On Supabase use the pooled connection string (Transaction mode, port 6543).
DATABASE_URL=

# Optional overrides (defaults shown)
# PINECONE_NAMESPACE=courses
# GEMINI_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
